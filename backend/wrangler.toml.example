# Cloudflare Worker deployment template — NOT active.
# Copy to backend/wrangler.toml only after creating a Cloudflare account and D1 database.
# Do not commit real IDs, credentials, tokens or private keys.
name = "margenpro-api"
main = "worker.js"
compatibility_date = "2026-11-01"

[vars]
# Use the exact issuer and audience from the chosen OIDC identity provider.
FRONTEND_ORIGIN = "https://martinbulla05-star.github.io"
AUTH_ISSUER = "https://REPLACE-WITH-TRUSTED-ISSUER/"
AUTH_AUDIENCE = "REPLACE-WITH-API-AUDIENCE"
AUTH_JWKS_URL = "https://REPLACE-WITH-TRUSTED-ISSUER/.well-known/jwks.json"

# Keep payments disabled until sandbox verification and deployment review.
PAYMENTS_ENABLED = "false"
PRICE_MINOR = "REPLACE-WITH-PRICE-IN-CENTS"
MP_COLLECTOR_ID = "REPLACE-WITH-MERCHANT-ID"
CHECKOUT_RETURN_URL = "https://martinbulla05-star.github.io/margenpro/"
MP_NOTIFICATION_URL = "https://REPLACE-WITH-API-HOST/api/webhooks/mercadopago"
# MP_ACCESS_TOKEN and MP_WEBHOOK_SECRET must be provisioned as Worker secrets.

[[d1_databases]]
binding = "DB"
database_name = "margenpro-commercial"
database_id = "REPLACE-WITH-D1-DATABASE-ID"
migrations_dir = "migrations"
